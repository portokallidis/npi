# npi configuration template.
# Copy to `.env` (next to package.json) or to ~/.harness/agent/.env, then fill in what you use.
# Both files are git-ignored. Real environment variables take precedence over these files.
# Anything left empty is simply skipped: the harness falls back to the next model in each list.

# ---------------------------------------------------------------- Frontier models (any you have)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# (Alternatively run /login inside npi; credentials are then stored in ~/.harness/agent/auth.json.)

# ---------------------------------------------------------------- Local / self-hosted models
# llama.cpp router server (models discovered automatically; pi's /llama command also uses it).
# Model refs look like: llamacpp/<model-id>
LLAMA_BASE_URL=
LLAMA_API_KEY=

# LM Studio (OpenAI-compatible endpoint, note the /v1). Model refs: lmstudio/<model-id>
LMSTUDIO_BASE_URL=
# Ollama. Model refs: ollama/<model-id>
OLLAMA_BASE_URL=
# vLLM, SGLang or any other OpenAI-compatible server. Model refs: vllm/<id>, openai-compatible/<id>
VLLM_BASE_URL=
VLLM_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Which local models the shared config means by "local/large" and "local/small"
# (used as fallbacks, as the local brainstorm panelist, and for the cheap router classifier).
HARNESS_LOCAL_LARGE=
HARNESS_LOCAL_SMALL=

# Examples:
#   LLAMA_BASE_URL=http://127.0.0.1:8080
#   LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
#   OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#   HARNESS_LOCAL_LARGE=llamacpp/qwen3.8-27b-gsq-rco-iq3_s
#   HARNESS_LOCAL_SMALL=lmstudio/qwen/qwen3.5-9b

# Device names for benchmark reports (/bench report, npm run demo). Reports never show IPs.
# HARNESS_DEVICE_<PROVIDER>=label, e.g.:
#   HARNESS_DEVICE_LLAMACPP=Linux GPU server
#   HARNESS_DEVICE_LMSTUDIO=Mac mini M4 (MLX)

# Optional: Langfuse traces (npx harness install npm:@langfuse/pi-observability-plugin)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------- Optional services
# Semantic Scholar works without a key but is heavily rate-limited (science mode).
SEMANTIC_SCHOLAR_API_KEY=
# Optional. docker compose uses a local placeholder if unset; set a random string for real use.
SEARXNG_SECRET=

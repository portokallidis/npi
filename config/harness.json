{
  "$comment": "Harness config. Model refs are 'provider/model-id' (e.g. 'openrouter/z-ai/glm-5.3'). 'local/large' and 'local/small' are aliases set per machine in .env (HARNESS_LOCAL_LARGE / HARNESS_LOCAL_SMALL). Copied to ~/.harness/agent/harness.json by `harness init`; edit that copy.",
  "router": {
    "classifierModels": [
      "local/small",
      "anthropic/claude-haiku-5-5",
      "openrouter/qwen/qwen3.8-flash"
    ],
    "classifierTimeoutMs": 8000,
    "minConfidence": 0.55,
    "defaultRoute": "chat",
    "alwaysTools": [
      "read",
      "tool_search",
      "delegate",
      "todo",
      "recall",
      "remember"
    ],
    "prewarm": true
  },
  "routes": {
    "chat": {
      "description": "General questions, explanations, writing, small talk. No tools needed beyond reading files.",
      "models": [
        "anthropic/claude-sonnet-5-5",
        "openai/gpt-5.6-terra",
        "local/large"
      ],
      "thinking": "low",
      "tools": [],
      "keywords": [],
      "skills": [],
      "policy": "ask"
    },
    "plan": {
      "description": "Planning before building: understand the codebase or problem, compare approaches, and produce a step-by-step plan without changing anything.",
      "models": [
        "anthropic/claude-opus-5-5",
        "openai/gpt-6.1-sol",
        "local/large"
      ],
      "thinking": "high",
      "tools": [
        "grep",
        "find",
        "ls",
        "bash",
        "web_search",
        "fetch_content"
      ],
      "keywords": [
        "\bplan\b",
        "how should (i|we) (implement|build|structure|approach)",
        "design (the|a)\b",
        "architecture for",
        "before (we|you) (start|code)"
      ],
      "prompt": "Planning mode: you cannot change files. Investigate (read, grep, delegate to scout), then give a concrete numbered plan with files to touch, risks and tests, and record it with the todo tool. Finish by suggesting `/handoff --to code <goal>`.",
      "agents": [
        "scout",
        "researcher"
      ],
      "skills": [],
      "policy": "readonly"
    },
    "code": {
      "description": "Reading, writing, debugging, refactoring or testing code in the current project; running shell commands.",
      "models": [
        "anthropic/claude-opus-5-5",
        "openai/gpt-6.1-sol",
        "local/large"
      ],
      "thinking": "medium",
      "tools": [
        "bash",
        "edit",
        "write",
        "grep",
        "find",
        "ls"
      ],
      "keywords": [
        "\\bfix\\b",
        "\\bbug\\b",
        "refactor",
        "implement",
        "\\btests?\\b",
        "stack ?trace",
        "compil(e|ation) (error|fail)",
        "build (error|fail)",
        "\\.(ts|js|py|go|rs|java|cs)\\b",
        "function",
        "repo"
      ],
      "agents": [
        "scout",
        "coder",
        "reviewer"
      ],
      "policy": "ask",
      "sandbox": false,
      "mcp": [
        "serena"
      ],
      "prompt": "For navigating large codebases prefer symbol tools (mcp__serena__*, load via tool_search) over reading whole files. Delegate broad exploration to scout and isolated implementation to coder (own worktree)."
    },
    "research": {
      "description": "Questions needing current or external information: news, docs, versions, prices, facts to look up and cite.",
      "models": [
        "anthropic/claude-sonnet-5-5",
        "google/gemini-3.1-pro-preview",
        "local/large"
      ],
      "thinking": "medium",
      "tools": [
        "web_search",
        "fetch_content",
        "get_search_content"
      ],
      "keywords": [
        "latest",
        "news",
        "look up",
        "search (for|the web)",
        "sources?",
        "cite",
        "current(ly)?",
        "release notes",
        "what'?s new"
      ],
      "prompt": "Ground factual claims in sources you fetched. Cite URLs inline.",
      "mcp": [
        "playwright"
      ],
      "agents": [
        "researcher",
        "browser"
      ],
      "policy": "readonly"
    },
    "browse": {
      "description": "Interacting with a specific website: open a URL, click, fill forms, take screenshots, read a page that needs JavaScript.",
      "models": [
        "anthropic/claude-sonnet-5-5",
        "openai/gpt-5.6-terra",
        "local/large"
      ],
      "thinking": "low",
      "tools": [
        "web_search",
        "fetch_content"
      ],
      "promote": [
        "mcp__playwright__browser_navigate",
        "mcp__playwright__browser_snapshot",
        "mcp__playwright__browser_click",
        "mcp__playwright__browser_type",
        "mcp__playwright__browser_take_screenshot"
      ],
      "keywords": [
        "https?://",
        "\\bopen (the )?(site|page|url)",
        "\\bclick\\b",
        "browse",
        "screenshot",
        "navigate to",
        "fill (in|out) the form"
      ],
      "prompt": "Use the Playwright browser tools (mcp__playwright__*) for pages that need interaction or JavaScript. Use tool_search to load other browser tools if needed.",
      "mcp": [
        "playwright"
      ],
      "agents": [
        "browser",
        "researcher"
      ],
      "policy": "ask"
    },
    "brainstorm": {
      "description": "Abstract or open-ended goals where the options should be explored: brainstorming, choosing an approach, decisions with trade-offs, strategy, second opinions.",
      "models": [
        "anthropic/claude-fable-5-1",
        "anthropic/claude-opus-5-5",
        "openai/gpt-6.1-sol",
        "local/large"
      ],
      "thinking": "medium",
      "tools": [
        "brainstorm"
      ],
      "keywords": [
        "brainstorm",
        "debate",
        "second opinion",
        "pros and cons",
        "\\bpanel\\b",
        "should (i|we)\\b",
        "trade-?offs?",
        "ground truth"
      ],
      "prompt": "For abstract goals or decisions, call the `brainstorm` tool with the user's goal and all relevant context; it asks the user for direction, explores every pathway with a multi-model panel and returns the options with trade-offs. Present its report; do not redo the work.",
      "skills": [],
      "agents": [
        "researcher"
      ],
      "policy": "readonly"
    },
    "science": {
      "description": "Scientific or medical questions that should be answered from the research literature: what do studies show, is there evidence that, systematic or literature review, meta-analysis, effect of X on Y.",
      "models": [
        "anthropic/claude-fable-5-1",
        "anthropic/claude-opus-5-5",
        "openai/gpt-6.1-sol",
        "local/large"
      ],
      "thinking": "medium",
      "tools": [
        "science",
        "papers",
        "web_search",
        "fetch_content"
      ],
      "keywords": [
        "\b(studies|study) (show|find|found|suggest)",
        "\bevidence (for|that|on)\b",
        "literature review",
        "systematic review",
        "meta-?analys",
        "\bpeer[- ]reviewed\b",
        "\bpapers? on\b",
        "\bclinical trials?\b",
        "\bRCTs?\b"
      ],
      "prompt": "For literature questions call the `science` tool with the full question and context; it runs a systematic-review-style pipeline and returns a digest with the report path. For quick lookups use `papers`. Always cite papers by [P#] or DOI.",
      "agents": [
        "researcher"
      ],
      "skills": [],
      "policy": "readonly"
    }
  },
  "mcpServers": {
    "playwright": {
      "url": "http://localhost:8931/mcp",
      "description": "Real Chromium browser: navigate pages, click, type, read the accessibility snapshot, take screenshots.",
      "exposure": "deferred",
      "timeout": 120
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=ide"
      ],
      "description": "Code intelligence via language servers: find symbols, references, definitions, and symbol-level edits.",
      "exposure": "deferred",
      "enabled": false,
      "timeout": 120
    }
  },
  "guard": {
    "defaultPolicy": "ask",
    "protectedPaths": [
      ".env",
      "**/.env",
      "**/.env.*",
      ".git/**",
      "**/*.pem",
      "**/*.key",
      "**/id_rsa*",
      "**/id_ed25519*",
      "~/.ssh/**",
      "~/.aws/**",
      "~/.harness/agent/auth.json",
      "~/.harness/agent/mcp-auth.json"
    ],
    "askCommands": [
      "\\brm\\s+-[a-z]*[rf]",
      "\\bgit\\s+(push|reset\\s+--hard|clean|checkout\\s+--|rebase|branch\\s+-D)",
      "\\bsudo\\b",
      "\\b(curl|wget)\\b[^|]*\\|\\s*(sh|bash)",
      "\\b(mkfs|dd|shutdown|reboot)\\b",
      "\\bchmod\\s+-R\\b",
      "\\b(npm|pnpm|yarn)\\s+publish\\b",
      "\\bdocker\\s+(rm|rmi|system\\s+prune)\\b",
      "\\bdrop\\s+(table|database)\\b",
      "\\bkill(all)?\\b"
    ],
    "readonlyCommands": [
      "^\\s*(ls|cat|head|tail|wc|pwd|tree|file|stat|du|which|echo)\\b",
      "^\\s*(grep|rg|find|fd)\\b",
      "^\\s*git\\s+(status|log|diff|show|blame|branch|ls-files|grep)\\b",
      "^\\s*(npm|pnpm|yarn)\\s+(ls|list|view|outdated)\\b",
      "^\\s*(node|python3?)\\s+--version\\b"
    ],
    "readonlyTools": [
      "read",
      "grep",
      "find",
      "ls",
      "tool_search",
      "web_search",
      "fetch_content",
      "get_search_content",
      "delegate",
      "todo",
      "recall",
      "papers",
      "brainstorm",
      "remember",
      "science"
    ],
    "askTools": [
      "browser_(fill_form|file_upload|run_code|evaluate|drop)",
      "_(submit|send|post|delete|purchase|pay)"
    ],
    "sandboxImage": "node:22-bookworm",
    "sandboxNetwork": "bridge"
  },
  "context": {
    "artifactDir": ".harness/artifacts",
    "toolResultInlineChars": 12000,
    "toolResultPreviewChars": 2500,
    "subagentContextTokens": 60000,
    "subagentSummaryTokens": 500,
    "digestModels": [
      "local/small"
    ],
    "digestMaxInputChars": 60000,
    "digestTimeoutMs": 20000
  },
  "subagents": {
    "maxConcurrency": 4,
    "maxParallelTasks": 8,
    "timeoutMs": 600000
  },
  "brainstorm": {
    "orchestrator": [
      "anthropic/claude-fable-5-1",
      "anthropic/claude-opus-5-5",
      "openai/gpt-6.1-sol",
      "local/large"
    ],
    "panel": [
      {
        "id": "claude",
        "model": "anthropic/claude-opus-5-5",
        "thinking": "medium"
      },
      {
        "id": "gpt",
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      {
        "id": "gemini",
        "model": "google/gemini-3.1-pro-preview",
        "thinking": "medium"
      },
      {
        "id": "local",
        "model": "local/large"
      },
      {
        "id": "local-small",
        "model": "local/small"
      }
    ],
    "minPanelists": 2,
    "judge": [
      "openrouter/z-ai/glm-5.3",
      "anthropic/claude-sonnet-5-5",
      "local/large"
    ],
    "evidenceAgent": "researcher",
    "maxDirectionQuestions": 4,
    "maxPathwaysPerPanelist": 6,
    "maxDisputes": 6,
    "crossExamRounds": 2,
    "recommendThreshold": 0.6,
    "askUser": true,
    "maxCostUSD": 5,
    "callTimeoutMs": 240000,
    "maxOutputTokens": {
      "panelist": 4000,
      "orchestrator": 8000
    },
    "reportDir": ".harness/brainstorms",
    "fallbackPersonas": [
      "a skeptical, risk-focused engineer who looks for failure modes",
      "a pragmatic operator who optimizes for cost and low maintenance",
      "a contrarian who argues for unconventional options"
    ]
  },
  "memory": {
    "dir": "memory",
    "pinnedChars": 1500
  },
  "telemetry": {
    "enabled": true,
    "dir": "telemetry"
  },
  "science": {
    "orchestrator": [
      "anthropic/claude-fable-5-1",
      "anthropic/claude-opus-5-5",
      "openai/gpt-6.1-sol",
      "local/large"
    ],
    "screeners": [
      "anthropic/claude-haiku-5-5",
      "openai/gpt-5.6-luna",
      "google/gemini-3.5-flash",
      "local/small",
      "local/large"
    ],
    "extractor": [
      "google/gemini-3.5-flash",
      "anthropic/claude-sonnet-5-5",
      "local/large"
    ],
    "verifier": [
      "anthropic/claude-sonnet-5-5",
      "openai/gpt-5.6-terra",
      "local/large"
    ],
    "sources": [
      "openalex",
      "pubmed",
      "semanticscholar",
      "arxiv"
    ],
    "maxDirectionQuestions": 3,
    "maxQueries": 5,
    "perQuery": 15,
    "maxCandidates": 60,
    "maxIncluded": 20,
    "askUser": true,
    "maxCostUSD": 5,
    "reportDir": ".harness/science"
  }
}
